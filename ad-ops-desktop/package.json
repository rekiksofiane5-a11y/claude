{
  "name": "ad-ops-suivi",
  "productName": "Suivi ad ops",
  "version": "1.1.0",
  "description": "Suivi opérationnel ad ops — application de bureau autonome",
  "main": "main.js",
  "author": "Sofiane Rekik",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:win-portable": "electron-builder --win portable --x64 --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "test": "node test/e2e.cjs"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.56.1"
  },
  "build": {
    "appId": "fr.adops.suivi",
    "productName": "Suivi ad ops",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Suivi ad ops",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Suivi-ad-ops-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Suivi-ad-ops-portable.exe"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
