{
  "name": "ad-ops-suivi",
  "productName": "My Work",
  "version": "1.3.0",
  "description": "My Work — suivi opérationnel ad ops, application de bureau autonome",
  "main": "main.js",
  "author": "Sofiane Rekik",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis msi --x64 --publish never",
    "build:win-portable": "electron-builder --win portable --x64 --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "test": "node test/e2e.cjs",
    "build:win-msi": "electron-builder --win msi --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.1"
  },
  "build": {
    "appId": "fr.adops.suivi",
    "productName": "My Work",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Work",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "My-Work-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "My-Work-portable.exe"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "publish": null,
    "msi": {
      "perMachine": true,
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Work",
      "runAfterFinish": false,
      "artifactName": "My-Work-${version}.msi"
    }
  }
}
